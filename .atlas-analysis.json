  "keyFeatures": [
    "No-registration Secret Santa group creation",
    "Participant exclusion rules (prevent specific pairings)",
    "Randomised draw algorithm with up to 1000 retry attempts",
    "Automated personalised email notifications via Nodemailer/Gmail SMTP",
    "Admin token-based group management link",
    "Angular SPA frontend with real-time form state preservation",
    "Node.js/Express REST API backed by MongoDB",
    "One-click deployment to Vercel (frontend + serverless backend)"
  ],
  "publicApiSurface": [
    "POST /api/sorteos — create a new group",
    "GET /api/sorteos/:adminToken — retrieve group details",
    "POST /api/sorteos/:adminToken/lanzar — run the draw and send emails",
    "GrupoService.crearSorteo(datosGrupo) — Angular service method",
    "GrupoService.getGrupo(adminToken) — Angular service method",
    "GrupoService.lanzarSorteo(adminToken) — Angular service method",
    "generarEmparejamientos(participantes) — draw algorithm utility",
    "enviarCorreosSorteo(parejas, participantes, nombreGrupo) — email utility"
  ]
